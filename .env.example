# Generate a unique random 32-byte key for each installation. Keep it private.
REASONIX_DATA_KEY=replace-with-64-hex-character-random-secret

# Production scans are denied until the service is assigned a tenant and explicit scope.
REASONIX_TENANT_ID=example-organization
REASONIX_ALLOWED_DOMAINS=example.com,example.org

# Optional: trust forwarded client IP headers only from explicitly trusted reverse-proxy peer IPs.
# Without this setting the audit log records the direct TCP peer address.
REASONIX_TRUSTED_PROXY_IPS=127.0.0.1

# Optional local API engines. In Windows development, serve.mjs maps loopback URLs
# to the configured private WSL address at startup; these endpoints are never public.
REASONIX_SQLMAP_API_URL=http://127.0.0.1:8775
REASONIX_SQLMAP_API_USERNAME=replace-with-local-service-user
REASONIX_SQLMAP_API_PASSWORD=replace-with-a-random-local-service-password
REASONIX_ZAP_API_URL=http://127.0.0.1:8090
REASONIX_ZAP_API_KEY=replace-with-a-random-local-service-key
